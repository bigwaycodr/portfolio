PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/internship_portfolio
CLIENT_URL=http://localhost:5000

# Optional email settings. If disabled, contact messages are still saved in MongoDB.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_TO_EMAIL=your_email@gmail.com
